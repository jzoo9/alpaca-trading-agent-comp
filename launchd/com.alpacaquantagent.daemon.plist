<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alpacaquantagent.daemon</string>

    <!-- EDIT THIS PATH to your actual repo location before loading -->
    <key>WorkingDirectory</key>
    <string>/Users/jessezhou/AlpacaAI Comp</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jessezhou/AlpacaAI Comp/.venv/bin/python</string>
        <string>-m</string>
        <string>alpaca_quant_agent.main</string>
        <string>--mode</string>
        <string>daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- launchd jobs run in a minimal environment and do NOT source your
         shell profile, so PATH must include ~/.local/bin explicitly here --
         that's where the uv installer put uv/uvx, which the daemon needs
         to launch alpaca-mcp-server as a subprocess. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/jessezhou/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jessezhou/AlpacaAI Comp/logs/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jessezhou/AlpacaAI Comp/logs/daemon.err.log</string>
</dict>
</plist>
