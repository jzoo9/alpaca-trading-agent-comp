# Alpaca paper trading credentials (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_paper_api_key_id
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_PAPER_TRADE=true

# Featherless AI (OpenAI-compatible) API key for the trade-selection reasoning layer
FEATHERLESS_API_KEY=your_featherless_api_key
# Verified live: this model handles tool-calling reliably (~2-3s per call).
# A Qwen3-30B-A3B-Instruct-2507 test either 500'd or hung indefinitely once
# a realistic tool schema was attached, despite Featherless documenting
# Qwen3 as tool-calling-capable -- don't assume a model works for this just
# because it's in the documented family; re-verify latency/reliability
# directly (see /tmp-style ping script pattern used during development)
# before switching.
FEATHERLESS_MODEL=moonshotai/Kimi-K2-Instruct

# Optional: override where the SQLite ledger / IV history db is written
AGENT_DB_PATH=./data/agent.db
